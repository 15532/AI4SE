# Development fallback only.
# Real API keys must be stored in the OS keychain in normal use.
# Do not copy real secrets into committed files.

APP_MODE=mock
WEBUI_PUBLIC_DEMO_ONLY=true

# Enable this only for local development fallback after documenting the risk.
ALLOW_ENV_CREDENTIAL_FALLBACK=false

