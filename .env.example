# 仅作为开发 fallback 示例。
# 推荐使用加密凭据文件存储真实 API key。
# 不要把真实 secret 写入已提交文件。

APP_MODE=mock
WEBUI_PUBLIC_DEMO_ONLY=true
HARNESS_CONFIG_PATH=config/harness.example.yaml
HARNESS_DB_PATH=data/harness.sqlite
HARNESS_CREDENTIAL_STORE_PATH=data/credentials.enc.json
HARNESS_MASTER_PASSWORD=
DEEPSEEK_API_KEY=

# DeepSeek provider 默认使用 config/harness.example.yaml 中的 deepseek-v4-flash。
# 真实 key 推荐通过 CLI 写入加密凭据文件；DEEPSEEK_API_KEY 仅作为受控环境变量 fallback。
