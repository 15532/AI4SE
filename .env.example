# 仅作为开发 fallback 示例。
# 正常使用时，真实 API key 必须存入 OS keychain。
# 不要把真实 secret 写入已提交文件。

APP_MODE=mock
WEBUI_PUBLIC_DEMO_ONLY=true

# 仅在记录明文风险后，为本地开发 fallback 显式启用。
ALLOW_ENV_CREDENTIAL_FALLBACK=false

# OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPATIBLE_MODEL=gpt-4.1-mini
# OPENAI_COMPATIBLE_API_KEY=never_commit_real_keys_here
