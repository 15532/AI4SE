# 仅作为开发 fallback 示例。
# 正常使用时，真实 API key 必须存入 OS keychain。
# 不要把真实 secret 写入已提交文件。

APP_MODE=mock
WEBUI_PUBLIC_DEMO_ONLY=true
HARNESS_CONFIG_PATH=config/harness.example.yaml
HARNESS_DB_PATH=data/harness.sqlite
DEEPSEEK_API_KEY=never_commit_real_keys_here

# 仅在记录明文风险后，为本地开发 fallback 显式启用。
ALLOW_ENV_CREDENTIAL_FALLBACK=false

# DeepSeek provider 默认使用 config/harness.example.yaml 中的 deepseek-v4-flash。
# 真实 key 只应写入未提交的 .env 或受控部署环境。
