{
  "name": "coding-agent-harness",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "bin": {
    "harness": "dist/src/cli/main.js"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "check:acceptance": "powershell -ExecutionPolicy Bypass -File scripts/acceptance-check.ps1",
    "demo:mechanisms": "tsx src/demo/mechanisms.ts",
    "demo:coding-task": "tsx src/demo/coding-task.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
